// schema.prisma

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/* =========================
   ENUMS
========================= */

enum Provider {
  KAKAO
  NAVER
  GOOGLE
}

enum UserStatus {
  ACTIVE
  DELETED
}

enum SceneStatus {
  DRAFT
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  CANCELLED
}

enum JobStatus {
  QUEUED
  SUBMITTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobStage {
  INSTANCE_CREATING
  IMAGESET_BUILDING
  SFM_FEATURE
  SFM_MATCH
  SFM_MAPPER
  SFM
  UNDISTORT
  GS_TRAINING
  MESH_EXTRACTION
  FINALIZING
  UPLOADING
  DONE
}

enum KeyframeSetStatus {
  PENDING
  RUNNING
  READY
  FAILED
  ARCHIVED
}

enum PostStatus {
  PUBLISHED
  DELETED
}

/* =========================
   MODELS
========================= */

model users {
  id              BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  provider        Provider
  providerId      String     @db.VarChar(128) @map("provider_id")
  nickname        String?    @db.VarChar(50)
  profileImageUrl String?    @db.VarChar(255) @map("profile_image_url")
  profileImageKey String?    @db.VarChar(1024) @map("profile_image_key")
  profileImageUpdatedAt DateTime? @map("profile_image_updated_at")
  status          UserStatus @default(ACTIVE)

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  scenes          scenes[]
  posts           posts[]
  likes           likes[]

  @@unique([provider, providerId], map: "uk_provider_provider_id")
  @@unique([nickname], map: "uk_nickname")
  @@map("users")
}

model scenes {
  id              BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt      @db.UnsignedBigInt @map("user_id")
  activeKeyframeSetId BigInt? @db.UnsignedBigInt @map("active_keyframe_set_id")
  title           String      @default("Untitled Scene") @db.VarChar(100)
  status          SceneStatus @default(DRAFT)
  uploadId        String?     @db.Char(36) @map("upload_id")
  inputVideoKey   String?     @db.VarChar(1024) @map("input_video_key")

  sfmResultKey    String?     @db.VarChar(1024) @map("sfm_result_key")
  gaussianSplatKey String?    @db.VarChar(1024) @map("gaussian_splat_key")
  meshKey         String?     @db.VarChar(1024) @map("mesh_key")
  thumbnailKey    String?     @db.VarChar(1024) @map("thumbnail_key")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  finishedAt      DateTime?   @map("finished_at")

  // Relations
  user              users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs              jobs[]
  keyframeSets      keyframe_sets[]  @relation("SceneKeyframeSets")
  activeKeyframeSet keyframe_sets?   @relation("SceneActiveKeyframeSet", fields: [activeKeyframeSetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "idx_scenes_user_created")
  @@index([status], map: "idx_scenes_status")
  @@index([uploadId], map: "idx_scenes_upload_id")
  @@index([activeKeyframeSetId], map: "idx_scenes_active_keyframe_set_id")
  @@map("scenes")
}

model jobs {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sceneId          BigInt    @db.UnsignedBigInt @map("scene_id")
  keyframeSetId    BigInt?   @db.UnsignedBigInt @map("keyframe_set_id")
  sourceJobId      BigInt?   @db.UnsignedBigInt @map("source_job_id")

  batchJobId       String?   @db.VarChar(128) @map("batch_job_id")
  uploadId         String?   @db.Char(36) @map("upload_id")
  pipeline         String    @default("3dgs") @db.VarChar(50)
  imageCount       Int       @default(0) @db.UnsignedInt @map("image_count")
  overlap          Int       @default(0) @db.UnsignedInt
  iteration        Int       @default(0) @db.UnsignedInt
  sfmResultKey     String?   @db.VarChar(1024) @map("sfm_result_key")
  gaussianSplatKey String?   @db.VarChar(1024) @map("gaussian_splat_key")
  meshKey          String?   @db.VarChar(1024) @map("mesh_key")
  thumbnailKey     String?   @db.VarChar(1024) @map("thumbnail_key")

  status           JobStatus @default(QUEUED)
  stage            JobStage  @default(INSTANCE_CREATING)

  progressPercent  Int       @default(0) @db.UnsignedTinyInt @map("progress_percent")
  cancelRequested  Boolean   @default(false) @map("cancel_requested")

  attempt          Int       @default(0) @db.UnsignedInt
  errorCode        String?   @db.VarChar(50) @map("error_code")
  errorMessage     String?   @db.VarChar(255) @map("error_message")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  startedAt        DateTime? @map("started_at")
  endedAt          DateTime? @map("ended_at")

  // Relations
  scene            scenes          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  keyframeSet      keyframe_sets?  @relation(fields: [keyframeSetId], references: [id], onDelete: SetNull)
  post             posts?

  @@unique([batchJobId], map: "uk_batch_job_id")
  @@index([sceneId, createdAt], map: "idx_jobs_scene_created")
  @@index([keyframeSetId], map: "idx_jobs_keyframe_set_id")
  @@index([sourceJobId], map: "idx_jobs_source_job_id")
  @@index([status, createdAt], map: "idx_jobs_status_created")
  @@index([stage], map: "idx_jobs_stage")
  @@index([uploadId], map: "idx_jobs_upload_id")
  @@index([pipeline], map: "idx_jobs_pipeline")
  @@map("jobs")
}

model keyframe_sets {
  id                    BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  sceneId               BigInt            @db.UnsignedBigInt @map("scene_id")
  version               Int               @db.UnsignedInt
  status                KeyframeSetStatus @default(PENDING)

  storagePrefix         String            @db.VarChar(1024) @map("storage_prefix")
  selectedFramesPrefix  String?           @db.VarChar(1024) @map("selected_frames_prefix")
  selectedFramesCsvKey  String?           @db.VarChar(1024) @map("selected_frames_csv_key")
  metricsKey            String?           @db.VarChar(1024) @map("metrics_key")
  configKey             String?           @db.VarChar(1024) @map("config_key")
  frameIndexPlotKey     String?           @db.VarChar(1024) @map("frame_index_plot_key")
  timelineComparisonKey String?           @db.VarChar(1024) @map("timeline_comparison_key")

  selectedFrameCount    Int               @default(0) @db.UnsignedInt @map("selected_frame_count")
  configHash            String?           @db.VarChar(128) @map("config_hash")
  configJson            Json?             @map("config_json")
  errorMessage          String?           @db.VarChar(255) @map("error_message")

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  scene                 scenes            @relation("SceneKeyframeSets", fields: [sceneId], references: [id], onDelete: Cascade)
  activeForScenes       scenes[]          @relation("SceneActiveKeyframeSet")
  jobs                  jobs[]

  @@unique([sceneId, version], map: "uk_keyframe_sets_scene_version")
  @@index([sceneId, status, createdAt], map: "idx_keyframe_sets_scene_status_created")
  @@index([status], map: "idx_keyframe_sets_status")
  @@map("keyframe_sets")
}

model posts {
  id            BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt     @db.UnsignedBigInt @map("user_id")
  jobId         BigInt     @db.UnsignedBigInt @map("job_id")

  title         String     @db.VarChar(100)
  status        PostStatus @default(PUBLISHED)

  likeCount     Int        @default(0) @db.UnsignedInt @map("like_count")
  downloadCount Int        @default(0) @db.UnsignedInt @map("download_count")

  shareUuid     String     @db.Char(36) @map("share_uuid")
  thumbnailKey  String?    @db.VarChar(1024) @map("thumbnail_key")
  thumbnailUpdatedAt DateTime? @map("thumbnail_updated_at")

  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relations
  user          users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           jobs       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  likes         likes[]

  @@unique([shareUuid], map: "uk_posts_share_uuid")
  @@unique([jobId], map: "uk_posts_job_id")
  @@index([userId, createdAt], map: "idx_posts_user_created")
  @@index([createdAt], map: "idx_posts_created")
  @@index([likeCount, createdAt], map: "idx_posts_like")
  @@index([downloadCount, createdAt], map: "idx_posts_download")
  @@map("posts")
}

model likes {
  userId    BigInt   @db.UnsignedBigInt @map("user_id")
  postId    BigInt   @db.UnsignedBigInt @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      posts    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, createdAt], map: "idx_likes_post_created")
  @@index([userId, createdAt], map: "idx_likes_user_created")
  @@map("likes")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime @map("expires_at")

  @@map("session")
}
